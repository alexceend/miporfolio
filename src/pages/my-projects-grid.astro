---
import Footer from '../components/Footer.astro';
import ProjectContainerGrid from '../components/ProjectContainerGrid.astro';
import Layout from '../layouts/Layout.astro';

import '../styles/global.css';
---

<Layout>
    <header class="sticky top-0 z-50 w-full">
        <nav class="mx-auto flex h-12 max-w-5xl items-center px-4">
            <a
                href="/miporfolio"
                class="rounded-md bg-black px-3 py-1.5 text-sm font-semibold text-theme-light-yellow transition hover:bg-white hover:text-orange-700"
            >
                ← Volver
            </a>
        </nav>
    </header>

    <main>
        <ProjectContainerGrid />
    </main>

    <Footer />
</Layout>