---
import Footer from '../components/Footer.astro';
import ProjectContainerGrid from '../components/ProjectContainerGrid.astro';
import Layout from '../layouts/Layout.astro';

import '../styles/global.css';
---

<Layout>
    <main class="min-h-screen">
        <div class="mx-auto max-w-5xl px-4 pt-6">
            <a
                href="/miporfolio"
                class="inline-flex items-center rounded-md bg-black px-4 py-2 text-sm font-semibold text-white transition hover:bg-white hover:text-orange-700"
            >
                ← Volver a la página principal
            </a>
        </div>

        <ProjectContainerGrid />
    </main>

    <Footer />
</Layout>