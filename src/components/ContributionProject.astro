---

const { title, image_paths, description, link, prs = [] } = Astro.props;
import '../styles/global.css';
import '../styles/carousel.css';
import { Icon } from 'astro-icon/components';

const hasCarousel = image_paths.length > 1;

---

<article class="pt-8 flex w-full">
    <div class="bg-theme-light-blue-alpha-70 p-4 sm:p-10 sm:pt-5 rounded-md shadow-md w-full flex flex-col overflow-hidden">
        
        <h1 class="flex justify-center text-theme-light-yellow text-lg sm:text-3xl pb-3 pt-3 bg-primary rounded-md border font-bold text-center">
            {title}
        </h1>

        <div class="carousel relative">
            <div class="carousel-container h-56 sm:h-80 flex items-center justify-center overflow-hidden">
                <div class="carousel-track mx-auto h-full flex items-center">
                    {image_paths.map((source: string | null | undefined) => (
                        <img 
                            src={source} 
                            alt={title} 
                            loading="lazy"
                            class="max-h-full max-w-full object-contain rounded-md py-2"
                        />
                    ))}
                </div>
            </div>

            <button 
                class:list={[
                    "carousel-btn prev absolute left-2 top-1/2 -translate-y-1/2 z-10",
                    hasCarousel 
                        ? "bg-theme-dark-gray text-theme-light-yellow hover:bg-white hover:text-black cursor-pointer" 
                        : "bg-gray-500 opacity-40 cursor-not-allowed"
                ]}
                disabled={!hasCarousel}
            >
                ‹
            </button>

            <button 
                class:list={[
                    "carousel-btn next absolute right-2 top-1/2 -translate-y-1/2 z-10",
                    hasCarousel 
                        ? "bg-theme-dark-gray text-theme-light-yellow hover:bg-white hover:text-black cursor-pointer" 
                        : "bg-gray-500 opacity-40 cursor-not-allowed"
                ]}
                disabled={!hasCarousel}
            >
                ›
            </button>
            
        </div>

        <p class="text-theme-light-yellow text-xs sm:text-xl py-1 mx-2 sm:mx-10 text-center">
            {description}
        </p>
        
        <div class="mt-auto">
            <a href={link} target="_blank" class="text-dark-blue">
                <div class="flex items-center space-x-2 justify-center">
                    <Icon name="github" />
                    <span>Github page</span>
                </div>
            </a>

            {
                prs.length > 0 && (
                <div class="mt-4 flex flex-col items-center gap-2">
                    {prs.map((pr: { name: string; link: string }) => (
                        <a
                            href={pr.link}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="flex items-center gap-2 text-orange-400 hover:text-orange-300 text-sm underline"
                        >
                            <img src="/miporfolio/merge-icon.svg" alt="Merge icon" class="w-6 h-6" />
                            <span class="underline text-black font-bold">{pr.name}</span>
                        </a>
                    ))}
                </div>
                )
            }
        </div>
    </div>

    <script type="module" src="/miporfolio/scripts/carousel.js" defer></script>
</article>