---
import Project from '../components/Project.astro';

import '../styles/global.css';
import '../styles/carousel.css';
import { projects } from '../data/content';

---

<section>
    <div class = "justify-center  max-w-6xl m-auto flex flex-col mt-10 border bg-primary text-bold rounded-3xl py-4 text-white">
        <h1 class="text-5xl text-center font-bold">
             <span class="text-orange-400 drop-shadow-[0_0_6px_rgba(251,146,60,0.45)]">&lt;/&gt;</span> 
                <span class="text-theme-light-yellow">Proyectos</span>
             <span class="text-orange-400 drop-shadow-[0_0_6px_rgba(251,146,60,0.45)]">&lt;/&gt;</span>
        </h1>
        <p class="text-s text-center mt-2 text-theme-light-yellow">
            Algunos proyectos que he desarrollado desde 2019...
        </p>
    </div>

    <!--
    <div class="flex justify-center mt-4">
        <a
            href="/miporfolio/my-projects-grid"
            class="rounded-md bg-black px-4 py-2 text-sm text-white transition hover:bg-white hover:text-orange-700"
        >
            Ver todos
        </a>
    </div>
    -->
    <!-- Voy a añadir una pequeña broma de paywall -->

    <div class="mt-4 flex justify-center">
        <button
            id="paywall-button"
            type="button"
            class="rounded-md bg-theme-dark-gray px-4 py-2 text-sm text-theme-light-yellow transition hover:bg-white hover:text-orange-700"
        >
            Ver todos
        </button>
    </div>

    <!-- Fake Paywall -->
    <div
        id="paywall"
        class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/70 px-4 backdrop-blur-sm"
    >
        <div class="w-full max-w-md rounded-xl bg-primary p-6 text-center shadow-2xl">
            <h2 class="text-2xl font-bold text-white">
                🔒 Contenido premium
            </h2>

            <p class="mt-3 text-white/80">
                Para desbloquear todas mis contribuciones debes realizar un
                pequeño pago de
            </p>

            <p class="mt-4 text-4xl font-bold text-orange-400">
                5,00 €
            </p>

            <button
                id="paypal-button"
                type="button"
                class="mt-6 w-full rounded-md bg-[#0070ba] px-4 py-3 font-bold text-white transition hover:bg-[#005ea6]"
            >
                PayPal
            </button>

            <button
                id="close-paywall"
                type="button"
                class="mt-3 text-sm text-white/60 transition hover:text-white"
            >
                Cancelar
            </button>
        </div>
    </div>

    <script>
        const paywallButton = document.querySelector('#paywall-button');
        const paywall = document.querySelector('#paywall');
        const closePaywall = document.querySelector('#close-paywall');
        const paypalButton = document.querySelector('#paypal-button');

        paywallButton?.addEventListener('click', () => {
            paywall?.classList.remove('hidden');
            paywall?.classList.add('flex');
        });

        closePaywall?.addEventListener('click', () => {
            paywall?.classList.add('hidden');
            paywall?.classList.remove('flex');
        });

        paypalButton?.addEventListener('click', () => {
            alert('ERROR 402: Too broke to continue...');
            window.location.href = '/miporfolio/my-projects-grid';
        });
    </script>

    <!-- Hasta aquí -->

    <div class="projects-carousel max-w-5xl mx-auto mt-8 px-4" data-projects-carousel>
        <div class="projects-shell">
            <button type="button" class="project-nav prev scale-75 sm:scale-100" aria-label="Proyecto anterior">‹</button>

            <div class="projects-viewport">
                <div class="projects-track">
                    {projects.map((project) => (
                        <div class="project-slide">
                            <Project
                                title={project.title}
                                image_paths={project.image_paths}
                                description={project.description}
                                year={project.year}
                                link={project.link}
                            />
                        </div>
                    ))}
                </div>
            </div>

            <button type="button" class="project-nav next projects-button scale-75 sm:scale-100" aria-label="Siguiente proyecto">›</button>
        </div>
    </div>
</section>

<script type="module" src="/miporfolio/scripts/projects-carousel.js" defer></script>
