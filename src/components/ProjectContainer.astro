---
import Project from '../components/Project.astro';

import '../styles/global.css';
import '../styles/carousel.css';

const images_catchemall = [
	"/miporfolio/catchemall-1.webp",
	"/miporfolio/catchemall-2.webp",
	"/miporfolio/catchemall-3.webp"
]

const images_danny = [
	"/miporfolio/danny-1.webp",
	"/miporfolio/danny-2.webp"
]

const images_nvim = [
	"/miporfolio/minevim.webp"
]

const images_dana = [
	"/miporfolio/dana-1.webp",
	"/miporfolio/dana-2.webp"
]

const images_unfollowers_insta = [
	"/miporfolio/unfollowers-1.webp",
	"/miporfolio/unfollowers-2.webp"
]

const images_solomo = [
	"/miporfolio/solomo-1.jpg"
]
const images_esteganografia = [
	"/miporfolio/esteganografia-1.webp"
]

const images_jojobird = [
	"/miporfolio/jojobird-1.webp",
	"/miporfolio/jojobird-2.webp"
]

const cats_spikes = [
    "/miporfolio/cats-spikes-1.webp",
    "/miporfolio/cats-spikes-2.webp"
]

const question_mark = [
    "/miporfolio/question-mark.webp"
]

const projects = [
    {
        title: "Catch'em all. Fishingrod",
        image_paths: images_catchemall,
        description: "Un juego simple en unity sobre pesca para experimentar con motores de creación de videojuegos",
        year: "2025",
        link: "https://github.com/alexceend/UnityFishingGame"
    },
    {
        title: "NVIM PLUGINS",
        image_paths: images_nvim,
        description: "Plugins para Nvim hechos en lua para customizar mi Arch - Linux",
        year: "2025",
        link: "https://github.com/alexceend/nvim-plugins"
    },
    {
        title: "Danny's frog",
        image_paths: images_danny,
        description: "Videojuego hecho en java para experimentar con Swing",
        year: "2024",
        link: "https://github.com/alexceend/Danny-s-frog"
    },
    {
        title: "Jojo bird",
        image_paths: images_jojobird,
        description: "Videojuego hecho en java junto a 2 compañeros para una Game JAM de la universidad.",
        year: "2024",
        link: "https://github.com/alexceend/jojo-bird"
    },
    {
        title: "Dana database",
        image_paths: images_dana,
        description: "Base de datos SQL simple que contiene información relevante sobre la DANA of Valencia. Incluyendo puntos de entrega de ayudas, páginas web de información y ayuda y las poblaciones y ciudades afectadas",
        year: "2025",
        link: "https://github.com/alexceend/dana-data-base"
    },
    {
        title: "Solomillo Mus Counter",
        image_paths: images_solomo,
        description: "Aplicación Android Kotlin para contar los puntos del juego de cartas 'Mus'",
        year: "2025",
        link: "https://github.com/alexceend/solomillo-mus-counter"
    },
    {
        title: "Unfollowers Insta",
        image_paths: images_unfollowers_insta,
        description: "Script en python que te permite ver los usuarios que no te siguen de vuelta en Instagram.",
        year: "2024",
        link: "https://github.com/alexceend/see-who-unfollowed-you-insta"
    },
    {
        title: "Esteganografía Java",
        image_paths: images_esteganografia,
        description: "Programa en java que te permite ocultar texto en imágenes utilizando esteganografía.",
        year: "2023",
        link: "https://github.com/alexceend/EsteganografiaJava"
    },
    {
        title: "Cats and spikes",
        image_paths: cats_spikes,
        description: "Mi primer videojuego hecho en Godot.",
        year: "2019",
        link: "https://github.com/alexceend/Cats-Spikes"
    },
    {
        title: "Upcoming projects",
        image_paths: question_mark,
        description: "Upcoming projects...",
        year: "",
        link: "https://github.com/alexceend"
    }
];
---
<section>
    <div class = "justify-center  max-w-6xl m-auto flex flex-col mt-10 border bg-primary text-bold rounded-3xl py-4 text-white">
        <h1 class="text-5xl text-center font-bold">
             <span class="text-orange-400 drop-shadow-[0_0_6px_rgba(251,146,60,0.45)]">&lt;/&gt;</span> 
                Proyectos
             <span class="text-orange-400 drop-shadow-[0_0_6px_rgba(251,146,60,0.45)]">&lt;/&gt;</span>
        </h1>
        <p class="text-s text-center mt-2">
            Algunos proyectos que he desarrollado desde 2019...
        </p>
    </div>

    <div class="projects-carousel max-w-5xl mx-auto mt-8 px-4" data-projects-carousel>
        <div class="projects-shell">
            <button type="button" class="project-nav prev scale-75 sm:scale-100" aria-label="Proyecto anterior">‹</button>

            <div class="projects-viewport">
                <div class="projects-track">
                    {projects.map((project) => (
                        <div class="project-slide">
                            <Project
                                title={project.title}
                                image_paths={project.image_paths}
                                description={project.description}
                                year={project.year}
                                link={project.link}
                            />
                        </div>
                    ))}
                </div>
            </div>

            <button type="button" class="project-nav next projects-button scale-75 sm:scale-100" aria-label="Siguiente proyecto">›</button>
        </div>
    </div>
</section>

<script type="module" src="/miporfolio/scripts/projects-carousel.js" defer></script>
