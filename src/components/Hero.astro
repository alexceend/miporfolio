---
import "../styles/global.css";
import { Icon } from "astro-icon/components";
---

<section>

    <div
        class="justify-center max-w-5xl mx-[6px] sm:mx-auto flex flex-col border bg-primary text-bold rounded-3xl border-white overflow-hidden"
    >
        <div
                class="relative flex items-center h-7 px-5 border-b border-white/10 py-4"
            >
                <div class="flex items-center gap-2">
                    <button type="button" aria-label="Minimizar" class="window-button">
                        <Icon name="window-min"/>
                    </button>

                    <button type="button" aria-label="Maximizar" class="window-button">
                        <Icon name="window-max"/>
                    </button>
                    <button type="button" aria-label="Cerrar" class="window-button">
                        <Icon name="window-close"/>
                    </button>
                </div>
                <span
                    class="absolute left-1/2 -translate-x-1/2 text-xs font-mono text-theme-light-yellow"
                >
                    ~/portfolio/
                </span>
            </div>

        <span
            class="text-[10px] sm:text-xs font-mono text-theme-light-yellow mt-2 ml-[2px] sm:ml-10"
        >
            <span class="text-theme-beige">alex</span><span class="text-theme-white">@porfolio</span>>$ whoami
        </span>
        <div class="mx-[2px] sm:mx-10 mt-2 border-t border-white/50"></div>

        <div
            class="grid grid-cols-1 sm:grid-cols-5 gap-4 w-full max-w-5xl mx-auto p-4 sm:p-0 sm:pb-2"
        >
            <div
                class="col-span-1 sm:col-span-3 sm:row-span-3 rounded-3xl flex justify-center items-center h-full min-h-[150px] p-4"
            >
                <div class="inline-block text-center text-theme-light-yellow">
                    <h1 class="text-3xl font-bold mb-5">
                        Hola! Soy <span
                            class="text-orange-400 drop-shadow-[0_0_6px_rgba(251,146,60,0.45)]"
                            >alexceend</span>
                    </h1>
                    <p class="text-m">
                        Estudiante de 4º de <span class="font-bold text-orange-300"
                            >Ingeniería de Software en la Universidad Politécnica de
                            Madrid</span
                        >. Ambicioso e inquieto por descubrir nuevas tecnologías y
                        desarrollar soluciones software
                    </p>
                    <br class="my-4" />
                    <p class="text-theme-light-yellow">
                        Disfruto contribuyendo en proyectos <span
                            class="font-bold text-orange-300">open source</span
                        > y aprendiendo de los demás desarrolladores
                    </p>
                </div>
            </div>
            <div
                class="col-span-1 sm:col-span-2 sm:col-start-4 rounded-3xl flex justify-center items-center h-full bg-theme-beige min-h-[100px] mr-2 mt-2"
            >
                <div
                    class="inline-block rotate-4 hover:-rotate-4 transition-transform"
                >
                    <a
                        href="https://github.com/alexceend"
                        target="_blank"
                        class="flex items-center space-x-2"
                    >
                        <Icon name="github" />
                        <span>My github !</span>
                    </a>
                </div>
            </div>
            <div
                class="col-span-1 sm:col-span-2 sm:col-start-4 sm:row-start-2 rounded-3xl flex justify-center items-center h-full bg-theme-light-blue min-h-[100px] mr-2"
            >
                <div
                    class="inline-block -rotate-4 hover:rotate-4 transition-transform"
                >
                    <a
                        href="mailto:alexceend@gmail.com"
                        target="_blank"
                        class="flex items-center space-x-2"
                    >
                        <Icon name="email" />
                        <span>Email me !</span>
                    </a>
                </div>
            </div>
            <div
                class="col-span-1 sm:col-span-2 sm:col-start-4 sm:row-start-3 rounded-3xl flex justify-center items-center h-full bg-theme-beige min-h-[100px] mr-2"
            >
                <div
                    class="inline-block rotate-4 hover:-rotate-4 transition-transform"
                >
                    <a
                        href="https://www.linkedin.com/in/alejandro-cendoya-ramiro-243016365/"
                        target="_blank"
                        class="flex items-center space-x-2"
                    >
                        <Icon name="linkedin" />
                        <span>Contact me !</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
