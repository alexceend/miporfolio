---
import ContributionProject from '../components/ContributionProject.astro';

import '../styles/global.css';
import '../styles/carousel.css';

const web_velada = [
    "/miporfolio/web-velada.webp"
]

const graphene_os = [
    "/miporfolio/graphene-os.webp"
]

const sharpemu = [
    "/miporfolio/sharpemu.webp"
]

const projects = [
    {
        title: "La velada del año - Midudev",
        image_paths: web_velada,
        description: "Web de 'La velada del año' creada por Midudev",
        year: "",
        link: "https://github.com/midudev/la-velada-web-oficial",
        prs: [
            { name: "midudev/la-velada-web-oficial#1483 ", link: "https://github.com/midudev/la-velada-web-oficial/pull/1483"},
            { name: "midudev/la-velada-web-oficial#1215 ", link: "https://github.com/midudev/la-velada-web-oficial/pull/1215"},
            { name: "midudev/la-velada-web-oficial#1205 ", link: "https://github.com/midudev/la-velada-web-oficial/pull/1205"}
        ]
    },
    {
        title: "GrapheneOS",
        image_paths: graphene_os,
        description: "Sistema operativo de código abierto centrado en la privacidad y seguridad para dispositivos móviles",
        year: "",
        link: "https://github.com/GrapheneOS/GrapheneOS",
        prs: [
            { name: "GrapheneOS/GrapheneOS#684 ", link: "https://github.com/GrapheneOS/Camera/pull/684"}
        ]
    },
    {
        title: "SharpEmu",
        image_paths: sharpemu,
        description: "Emulador experimental de PS5 para Windows, Linux y macOS ",
        year: "",
        link: "https://github.com/SharpEmu/SharpEmu",
        prs: [
            { name: "sharpemu/sharpemu#161 ", link: "https://github.com/SharpEmu/SharpEmu/pull/161"},
            { name: "sharpemu/sharpemu#162 ", link: "https://github.com/SharpEmu/SharpEmu/pull/162"},   
            { name: "sharpemu/sharpemu#165 ", link: "https://github.com/SharpEmu/SharpEmu/pull/165"},
            { name: "sharpemu/sharpemu#148 ", link: "https://github.com/SharpEmu/SharpEmu/pull/148"},
            { name: "sharpemu/sharpemu#279 ", link: "https://github.com/SharpEmu/SharpEmu/pull/279"},
            { name: "sharpemu/sharpemu#735 ", link: "https://github.com/SharpEmu/SharpEmu/pull/735"},
        ]
    }
];
---
<section>
    <div class = "justify-center  max-w-6xl m-auto flex flex-col mt-10 border bg-primary text-bold rounded-3xl py-4 text-white">
        <h1 class="text-2xl sm:text-5xl sm:gap-2 text-center font-bold">
             <span class="text-orange-400 drop-shadow-[0_0_6px_rgba(251,146,60,0.45)]">&lt;/&gt;</span> 
                <span class="text-theme-light-yellow">Contribuciones</span>
             <span class="text-orange-400 drop-shadow-[0_0_6px_rgba(251,146,60,0.45)]">&lt;/&gt;</span>
        </h1>
        <p class="text-s text-center mt-2">
            Algunos proyectos de código abierto en los que he contribuido
        </p>
    </div>

    <!--
    <div class="flex justify-center mt-4">
        <a
            href="/miporfolio/my-contributions-grid"
            class="rounded-md bg-black px-4 py-2 text-sm text-white transition hover:bg-white hover:text-orange-700"
        >
            Ver todos
        </a>
    </div>
    -->

    <!-- Voy a añadir una pequeña broma de paywall -->

    <div class="mt-4 flex justify-center">
        <button
            id="contributions-paywall-button"
            type="button"
            class="rounded-md bg-black px-4 py-2 text-sm text-theme-light-yellow transition hover:bg-white hover:text-orange-700"
        >
            Ver todos
        </button>
    </div>

    <!-- Fake Paywall -->
    <div
        id="contributions-paywall"
        class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/70 px-4 backdrop-blur-sm"
    >
        <div class="w-full max-w-md rounded-xl bg-primary p-6 text-center shadow-2xl">
            <h2 class="text-2xl font-bold text-white">
                🔒 Contenido premium
            </h2>

            <p class="mt-3 text-white/80">
                Para desbloquear todas mis contribuciones debes realizar un
                pequeño pago de
            </p>

            <p class="mt-4 text-4xl font-bold text-orange-400">
                5,00 €
            </p>

            <button
                id="contributions-paypal-button"
                type="button"
                class="mt-6 w-full rounded-md bg-[#0070ba] px-4 py-3 font-bold text-white transition hover:bg-[#005ea6]"
            >
                PayPal
            </button>

            <button
                id="contributions-close-paywall"
                type="button"
                class="mt-3 text-sm text-white/60 transition hover:text-white"
            >
                Cancelar
            </button>
        </div>
    </div>

    <script>
        const paywallButton = document.querySelector('#contributions-paywall-button');
        const paywall = document.querySelector('#contributions-paywall');
        const closePaywall = document.querySelector('#contributions-close-paywall');
        const paypalButton = document.querySelector('#contributions-paypal-button');

        paywallButton?.addEventListener('click', () => {
            paywall?.classList.remove('hidden');
            paywall?.classList.add('flex');
        });

        closePaywall?.addEventListener('click', () => {
            paywall?.classList.add('hidden');
            paywall?.classList.remove('flex');
        });

        paypalButton?.addEventListener('click', () => {
            alert('ERROR 402: Too broke to continue...');
            window.location.href = '/miporfolio/my-contributions-grid';
        });
    </script>

    <!-- Hasta aquí -->

    <div class="projects-carousel max-w-5xl mx-auto mt-8 px-4" data-contributions-carousel>
        <div class="projects-shell">
            <button type="button" class="project-nav prev contributions-prev scale-75 sm:scale-100" aria-label="Proyecto anterior">‹</button>

            <div class="projects-viewport">
                <div class="projects-track">
                    {projects.map((project) => (
                        <div class="project-slide">
                            <ContributionProject
                                title={project.title}
                                image_paths={project.image_paths}
                                description={project.description}
                                year={project.year}
                                link={project.link}
                                prs={project.prs}
                            />
                        </div>
                    ))}
                </div>
            </div>

            <button type="button" class="project-nav next contributions-next scale-75 sm:scale-100" aria-label="Siguiente proyecto">›</button>
        </div>
    </div>
</section>

<script type="module" src="/miporfolio/scripts/projects-carousel.js" defer></script>
